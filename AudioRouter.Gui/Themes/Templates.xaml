<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:AudioRouter.Core.Models;assembly=AudioRouter.Core"
                    xmlns:guimodels="clr-namespace:AudioRouter.Gui.Models"
                    xmlns:conv="clr-namespace:AudioRouter.Gui.Converters"
                    xmlns:loc="clr-namespace:AudioRouter.Gui.Services.Localization">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/Tokens.xaml" />
        <ResourceDictionary Source="/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NullToVisibilityConverter x:Key="NotNullToVis" />
    <conv:PeakToArcConverter x:Key="PeakToArc" />
    <conv:VolumeToWidthConverter x:Key="VolumeToWidth" />

    <BooleanToVisibilityConverter x:Key="BoolConv" />

    <!-- ============================================================
         自绘拖拽预览（跟随光标的浮层，视觉规格来自设计文档 5.2）
         ============================================================ -->
    <DataTemplate x:Key="DragPreviewTemplate" DataType="{x:Type guimodels:DragPreviewModel}">
        <Border Background="{StaticResource Brush.Bg.Surface2}"
                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="1"
                CornerRadius="10" Padding="10,8" Opacity="0.96"
                Effect="{StaticResource Shadow.Drag}">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="6" Background="{Binding AvatarBrush}">
                    <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding DisplayName}" Margin="9,0,0,0" VerticalAlignment="Center"
                           FontWeight="SemiBold" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                <Border Background="{StaticResource Brush.Accent.Weak}" CornerRadius="4" Padding="6,1"
                        Margin="9,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ExtraText}" FontSize="11"
                               Foreground="{StaticResource Brush.Accent}" />
                </Border>
                <Path Data="{StaticResource Geo.Route}" Stretch="Uniform" Width="13" Height="13"
                      Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.6"
                      Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ============================================================
         Toast：右下角浮层提示（带撤销操作）
         ============================================================ -->
    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type models:ToastModel}">
        <Border x:Name="Root" Width="320" Margin="0,0,0,10" CornerRadius="10"
                Background="{StaticResource Brush.Bg.Surface2}"
                BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                Effect="{StaticResource Shadow.Float}" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Slide" Y="12" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border x:Name="Stripe" Grid.Column="0" CornerRadius="10,0,0,10"
                        Background="{StaticResource Brush.Accent}" />

                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="13,11,8,11"
                           TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource Brush.Text.Primary}" />

                <Button Grid.Column="2" Content="{Binding ActionText}" Margin="0,0,4,0"
                        VerticalAlignment="Center" Style="{StaticResource Btn.Ghost}"
                        AutomationProperties.Name="{loc:Loc a11y.undoAction}"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.ToastActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />

                <Button Grid.Column="3" Width="22" Height="22" Margin="0,0,8,0"
                        VerticalAlignment="Center" Style="{StaticResource Btn.Icon}"
                        ToolTip="{loc:Loc action.closeToast}"
                        AutomationProperties.Name="{loc:Loc action.closeToast}"
                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Path Data="{StaticResource Geo.Win.Close}" Stretch="Uniform" Width="8" Height="8"
                          Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.4" />
                </Button>
            </Grid>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Success">
                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource Brush.State.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource Brush.State.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource Brush.State.Danger}" />
            </DataTrigger>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="Y"
                                         From="12" To="0" Duration="0:0:0.16" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================
         左侧：应用程序条目（行高 52）
         ============================================================ -->
    <DataTemplate x:Key="AppSessionTemplate" DataType="{x:Type models:AppSession}">
        <Grid x:Name="Row" Height="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 图标 + 峰值环 -->
            <Grid Grid.Column="0" Width="48" Height="48" VerticalAlignment="Center" Margin="10,0,10,0">
                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{Binding AvatarBrush}"
                        Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Image Width="36" Height="36" Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding Icon, Converter={StaticResource NotNullToVis}}">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8" />
                    </Image.Clip>
                </Image>

                <Path Data="{Binding Peak, Converter={StaticResource PeakToArc}}"
                      Stroke="{StaticResource Brush.Accent}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="48" Height="48" IsHitTestVisible="False"
                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <!-- 名称 / 进程名 · PID -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Txt.BodyStrong}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Txt.Caption}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 路由徽章 / 静音 / 音量 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Border Style="{StaticResource Badge.Accent}" Margin="0,0,8,0"
                        Visibility="{Binding HasRoutes, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Geo.Route}" Stretch="Uniform" Width="11" Height="11"
                              Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.6"
                              VerticalAlignment="Center" Margin="0,0,3,0" />
                        <TextBlock Text="{Binding RouteCount}" FontSize="11"
                                   Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Path Data="{StaticResource Geo.Mute}" Stretch="Uniform" Width="14" Height="14"
                      Stroke="{StaticResource Brush.State.Muted}" StrokeThickness="1.5"
                      Margin="0,0,8,0" VerticalAlignment="Center"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />

                <StackPanel Width="46" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VolumePercent, StringFormat={}{0}%}" Style="{StaticResource Txt.Caption}"
                               HorizontalAlignment="Right" />
                    <Border Height="4" CornerRadius="2" Margin="0,4,0,0"
                            Background="{StaticResource Brush.Bg.Sunken}">
                        <Border Width="{Binding Volume, Converter={StaticResource VolumeToWidth}, ConverterParameter=40}"
                                CornerRadius="2" HorizontalAlignment="Left"
                                Background="{StaticResource Brush.Accent}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.4" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================
         右侧：已路由应用 chip（per-route：同一应用可在多个设备各有一份）
         ============================================================ -->
    <DataTemplate x:Key="RouteChipTemplate" DataType="{x:Type models:RouteChip}">
        <Border x:Name="ChipRoot" Background="{StaticResource Brush.Bg.Surface2}"
                BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="8" Padding="6,5" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal">
                <Grid Width="26" Height="26">
                    <Border CornerRadius="6" Background="{Binding AvatarBrush}"
                            Visibility="{Binding Icon, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="26" Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding Icon, Converter={StaticResource NotNullToVis}}">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,26,26" RadiusX="6" RadiusY="6" />
                        </Image.Clip>
                    </Image>
                </Grid>

                <TextBlock Text="{Binding DisplayName}" Margin="7,0,0,0" VerticalAlignment="Center"
                           FontSize="12.5" MaxWidth="140" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayName}" />

                <!-- 复制（Duplicate）与路由（Route）的可见区分 -->
                <Border Background="{StaticResource Brush.Accent.Weak}" CornerRadius="4" Padding="5,0"
                        Margin="7,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:Loc route.duplicate}" FontSize="10" Foreground="{StaticResource Brush.Accent}" />
                </Border>

                <Path Data="{StaticResource Geo.Mute}" Stretch="Uniform" Width="12" Height="12"
                      Stroke="{StaticResource Brush.State.Muted}" StrokeThickness="1.5"
                      Margin="7,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" />

                <Button x:Name="RemoveButton" Style="{StaticResource Btn.ChipRemove}"
                        ToolTip="{loc:Loc action.removeRoute}"
                        AutomationProperties.Name="{loc:Loc action.removeRoute}"
                        AutomationProperties.AutomationId="RouteChipRemove"
                        AutomationProperties.HelpText="{loc:Loc a11y.removeRouteHint}"
                        Command="{Binding DataContext.RemoveRouteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Path Data="{StaticResource Geo.Win.Close}" Stretch="Uniform" Width="8" Height="8"
                          Stroke="{StaticResource Brush.State.Muted}" StrokeThickness="1.5" />
                </Button>
            </StackPanel>
        </Border>

        <DataTemplate.Triggers>
            <Trigger SourceName="ChipRoot" Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipRoot" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                <Setter TargetName="ChipRoot" Property="Background" Value="{StaticResource Brush.Bg.Hover}" />
                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
            </Trigger>
            <DataTrigger Binding="{Binding IsDragging}" Value="True">
                <Setter TargetName="ChipRoot" Property="Opacity" Value="0.4" />
                <Setter TargetName="ChipRoot" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================
         右侧：音频设备卡片
         ============================================================ -->
    <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type models:AudioDevice}">
        <Border x:Name="Root" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <!-- 卡片头 -->
                <Grid Height="56" Margin="16,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                            Background="{StaticResource Brush.Bg.Sunken}"
                            BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path x:Name="KindIcon" Data="{StaticResource Geo.Speaker}" Stretch="Uniform"
                              Width="16" Height="16" Stroke="{StaticResource Brush.Text.Secondary}"
                              StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DeviceName" Text="{Binding FriendlyName}"
                                   Style="{StaticResource Txt.Title}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FriendlyName}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Txt.Caption}" />
                            <TextBlock Text="·" Margin="6,0,6,0" Style="{StaticResource Txt.Caption}"
                                       Visibility="{Binding HasFormat, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding FormatText}" Style="{StaticResource Txt.Caption}"
                                       ToolTip="{Binding FormatText}"
                                       Visibility="{Binding HasFormat, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Badge.Accent}" Margin="0,0,8,0"
                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc device.default}" FontSize="11"
                                       Foreground="{StaticResource Brush.Accent}" />
                        </Border>
                        <Border Style="{StaticResource Badge.Warning}"
                                Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc device.disabled}" FontSize="11"
                                       Foreground="{StaticResource Brush.State.Warning}" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource Brush.Border.Subtle}" Margin="16,0,16,0" />

                <!-- 已路由应用（per-route chip） -->
                <ItemsControl ItemsSource="{Binding Routes}" Margin="16,12,8,0"
                              ItemTemplate="{StaticResource RouteChipTemplate}"
                              Visibility="{Binding HasRoutes, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 拖放区 -->
                <Grid Margin="16,10,16,16" MinHeight="48">
                    <Rectangle x:Name="DropZone" RadiusX="8" RadiusY="8"
                               Fill="{StaticResource Brush.Bg.Sunken}"
                               Stroke="{StaticResource Brush.Border.Strong}" StrokeThickness="1"
                               StrokeDashArray="4 3" />
                    <TextBlock x:Name="DropHint" Text="{Binding DropHint}"
                               Style="{StaticResource Txt.Micro}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="12,0"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding UsesHeadphoneIcon}" Value="True">
                <Setter TargetName="KindIcon" Property="Data" Value="{StaticResource Geo.Headphones}" />
            </DataTrigger>

            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                <Setter TargetName="DeviceName" Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </DataTrigger>

            <!-- 拖拽悬停命中 -->
            <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Accent.Weak}" />
                <Setter TargetName="DropZone" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                <Setter TargetName="DropZone" Property="Fill" Value="{StaticResource Brush.Accent.Weak}" />
                <Setter TargetName="DropHint" Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </DataTrigger>

            <!-- 已存在该应用：幂等拒绝（后声明，覆盖上面的颜色） -->
            <DataTrigger Binding="{Binding IsDropRejected}" Value="True">
                <Setter TargetName="DropZone" Property="Stroke" Value="{StaticResource Brush.State.Warning}" />
                <Setter TargetName="DropHint" Property="Foreground" Value="{StaticResource Brush.State.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
