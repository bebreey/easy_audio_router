<Window x:Class="AudioRouter.Gui.Views.DuplicateTargetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AudioRouter.Gui.Services.Localization"
        Title="{loc:Loc dialog.duplicate.title}"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.App}"
        Background="{StaticResource Brush.Bg.Sunken}">

    <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
            Background="{StaticResource Brush.Bg.Sunken}"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">

        <StackPanel Margin="20">
            <TextBlock Text="{loc:Loc dialog.duplicate.title}" Style="{StaticResource Txt.Title}" />
            <TextBlock x:Name="Subtitle" Margin="0,8,0,0" Style="{StaticResource Txt.Caption}"
                       TextWrapping="Wrap" />

            <Border Margin="0,16,0,0" CornerRadius="{StaticResource Radius.Md}"
                    Background="{StaticResource Brush.Bg.Window}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                    Padding="14,10" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TargetList" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="Summary" Margin="0,12,0,0" Style="{StaticResource Txt.Caption}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:Loc action.cancel}" Style="{StaticResource Btn.Ghost}" Click="Cancel_Click" />
                <Button x:Name="ApplyButton" Content="{loc:Loc action.apply}" Margin="10,0,0,0"
                        Style="{StaticResource Btn.Primary}" Click="Apply_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
