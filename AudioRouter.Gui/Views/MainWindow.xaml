<Window x:Class="AudioRouter.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AudioRouter.Core.Models;assembly=AudioRouter.Core"
        xmlns:loc="clr-namespace:AudioRouter.Gui.Services.Localization"
        xmlns:vm="clr-namespace:AudioRouter.Gui.ViewModels"
        Title="Audio Router"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#00000000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.App}"
        Foreground="{StaticResource Brush.Text.Primary}"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource Brush.Bg.Window}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= 标题栏 ================= -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="16,0,0,0" IsHitTestVisible="False">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource Brush.Accent}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Audio Router" Style="{StaticResource Txt.BodyStrong}"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 语言 -->
                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        ToolTip="{loc:Loc toolbar.language}"
                        AutomationProperties.Name="{loc:Loc toolbar.language}"
                        Click="Language_Click">
                    <Path Data="{StaticResource Geo.Globe}" Stretch="Uniform" Width="15" Height="15"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" />
                </Button>

                <!-- 刷新 -->
                <Button Grid.Column="3" Style="{StaticResource Btn.Icon}"
                        Command="{Binding RefreshCommand}" ToolTip="{loc:Loc toolbar.refresh}"
                        AutomationProperties.Name="{loc:Loc toolbar.refresh}"
                        Margin="0,0,8,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geo.Refresh}" Stretch="Uniform" Width="14" Height="14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5" />
                </Button>

                <!-- 窗口按钮 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Style="{StaticResource Btn.TitleBar}" Click="Minimize_Click"
                            ToolTip="{loc:Loc window.minimize}"
                            AutomationProperties.Name="{loc:Loc window.minimize}">
                        <Path Data="{StaticResource Geo.Win.Min}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource Btn.TitleBar}" Click="MaximizeRestore_Click"
                            ToolTip="{loc:Loc window.maximize}"
                            AutomationProperties.Name="{loc:Loc window.maximize}">
                        <Path x:Name="MaxGlyph" Data="{StaticResource Geo.Win.Max}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource Btn.Close}" Click="Close_Click"
                            ToolTip="{loc:Loc window.close}"
                            AutomationProperties.Name="{loc:Loc window.close}">
                        <Path Data="{StaticResource Geo.Win.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <Border Height="1" VerticalAlignment="Bottom" Grid.ColumnSpan="5"
                        Background="{StaticResource Brush.Border.Subtle}" />
            </Grid>

            <!-- ================= 主体 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="300" MaxWidth="520" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========== 左：应用程序列表 ========== -->
                <Grid Grid.Column="0" Margin="16,4,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc section.apps}" Style="{StaticResource Txt.SectionHeader}" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding SessionCountText}" FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Tertiary}" />
                        </Border>
                    </StackPanel>

                    <TextBox Grid.Row="1" Style="{StaticResource SearchBox}" Tag="{loc:Loc search.placeholder}"
                             AutomationProperties.Name="{loc:Loc search.placeholder}"
                             AutomationProperties.HelpText="{loc:Loc a11y.searchHint}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" />

                    <Grid Grid.Row="2">
                        <!-- 拖拽 chip 悬停到这里 = 移除该路由。
                             注意：BorderBrush/Background 的默认值必须写在 Style 里，
                             写成元素上的本地值会压过 DataTrigger（本地值优先级更高）。 -->
                        <Border x:Name="LeftDropZone" CornerRadius="{StaticResource Radius.Md}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRemoveTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.State.Danger}" />
                                            <Setter Property="Background" Value="{StaticResource Brush.Danger.Weak}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <ListBox x:Name="AppList"
                                     Style="{StaticResource AppList}"
                                     ItemsSource="{Binding SessionsView}"
                                     ItemTemplate="{StaticResource AppSessionTemplate}"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     PreviewMouseRightButtonUp="AppList_PreviewMouseRightButtonUp">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2,4,2,7">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource Txt.SectionHeader}" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ItemCount}" FontSize="11"
                                                               Foreground="{StaticResource Brush.Text.Tertiary}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>
                        </Border>

                        <!-- 空状态：确实没有应用在发声 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="0,0,0,40"
                                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource Geo.Empty}" Stretch="Uniform" Width="52" Height="52"
                                  Stroke="{StaticResource Brush.Text.Disabled}" StrokeThickness="1.2"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc empty.noAudio.title}" Margin="0,16,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                            <TextBlock Text="{loc:Loc empty.noAudio.subtitle}" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" Style="{StaticResource Txt.Caption}" />
                            <Button Content="{loc:Loc action.refresh}" Style="{StaticResource Btn.Ghost}" Margin="0,16,0,0"
                                    HorizontalAlignment="Center" Command="{Binding RefreshCommand}" />
                        </StackPanel>

                        <!-- 空状态：搜索无匹配 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="0,0,0,40"
                                    Visibility="{Binding ShowNoMatchState, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:Loc empty.noMatch.title}" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                            <TextBlock Text="{loc:Loc empty.noMatch.subtitle}" Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Style="{StaticResource Txt.Caption}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="1" Style="{StaticResource VSplitter}" />

                <!-- ========== 右：音频设备列表 ========== -->
                <Grid Grid.Column="2" Margin="10,4,16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc section.devices}" Style="{StaticResource Txt.SectionHeader}" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                            <TextBlock Text="{Binding DeviceCountText}" FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Tertiary}" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer x:Name="DeviceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel Margin="0,4,0,16">
                            <!-- 可用设备（默认设备置顶） -->
                            <ItemsControl x:Name="AvailableDeviceList" ItemsSource="{Binding AvailableDevices}"
                                          ItemTemplate="{StaticResource DeviceCardTemplate}"
                                          PreviewMouseRightButtonUp="DeviceList_PreviewMouseRightButtonUp" />

                            <!-- 已禁用 / 已断开：默认折叠，避免几十个失效端点刷屏 -->
                            <Button Command="{Binding ToggleDisabledCommand}" Cursor="Hand"
                                    Margin="0,4,0,10"
                                    Visibility="{Binding HasDisabledDevices, Converter={StaticResource BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                                Padding="9,8" BorderThickness="1"
                                                BorderBrush="{StaticResource Brush.Border.Subtle}">
                                            <ContentPresenter HorizontalAlignment="Left" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource Brush.Bg.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding DisabledHeaderText}"
                                           Style="{StaticResource Txt.SectionHeader}" />
                            </Button>

                            <ItemsControl x:Name="DisabledDeviceList" ItemsSource="{Binding DisabledDevices}"
                                          ItemTemplate="{StaticResource DeviceCardTemplate}"
                                          PreviewMouseRightButtonUp="DeviceList_PreviewMouseRightButtonUp"
                                          Visibility="{Binding ShowDisabled, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ================= 右下角 Toast 浮层 ================= -->
            <ItemsControl Grid.Row="1" Panel.ZIndex="99" ItemsSource="{Binding Toasts}"
                          ItemTemplate="{StaticResource ToastTemplate}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,22,20" />

            <!-- ================= 状态栏 ================= -->
            <Grid Grid.Row="2" Margin="16,0,16,0">
                <Border Height="1" VerticalAlignment="Top" Margin="-16,0,-16,0"
                        Background="{StaticResource Brush.Border.Subtle}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{StaticResource Brush.State.Success}" />
                    <TextBlock Text="{Binding EngineText}" Style="{StaticResource Txt.Micro}"
                               Margin="7,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Badge.Warning}" Margin="10,0,0,0"
                            Visibility="{Binding IsDemo, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc badge.demo}" FontSize="10"
                                   Foreground="{StaticResource Brush.State.Warning}" />
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Txt.Micro}"
                           ToolTip="{Binding RoutingStatusDetail}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
