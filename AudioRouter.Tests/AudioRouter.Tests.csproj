<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AudioRouter.Tests</RootNamespace>
    <!-- 程序集名必须与 Core 里的 InternalsVisibleTo 一致 -->
    <AssemblyName>AudioRouter.Tests</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioRouter.Core\AudioRouter.Core.csproj" />
  </ItemGroup>

</Project>
